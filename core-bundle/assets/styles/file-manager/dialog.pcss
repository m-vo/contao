dialog[data-controller="contao--dialog"].file-manager--proxy {
    width: 95%;
    max-width: 120ch;

    .dialog_wrapper {
        max-width: revert !important;
    }

    .header_wrapper {
        border-bottom: 1px solid var(--border);
    }

    .tl_tbox:not(:has(*)) {
        display: none;
    }
}
